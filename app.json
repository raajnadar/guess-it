{
  "expo": {
    "name": "Guess it",
    "description": "Guess the number mobile game developed by Rajendran Nadar",
    "slug": "guess-it",
    "scheme": "guessit",
    "platforms": [
      "android",
      "ios"
    ],
    "githubUrl": "https://github.com/raajnadar/guess-it",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "assets/*"
    ],
    "ios": {
      "bundleIdentifier": "in.raajnadar.guessit",
      "buildNumber": "1"
    },
    "android": {
      "package": "in.raajnadar.guessit",
      "versionCode": 1
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      "@react-native-vector-icons/material-design-icons",
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
