{
	"name": "guess-it",
	"version": "0.0.1",
	"private": true,
	"main": "expo-router/entry",
	"scripts": {
		"android": "expo run:android",
		"ios": "expo start --ios",
		"start": "expo start",
		"test": "jest",
		"lint": "eslint . --ext .ts,.tsx",
		"typescript": "yarn tsc --noEmit"
	},
	"dependencies": {
		"@react-native-vector-icons/material-design-icons": "^13.1.4",
		"@rootnative/components": "0.0.0-alpha.24",
		"@rootnative/core": "0.0.0-alpha.24",
		"@rootnative/inertia": "0.0.18",
		"expo": "~57.0.27",
		"expo-constants": "~57.0.21",
		"expo-font": "~57.0.4",
		"expo-linking": "~57.0.12",
		"expo-router": "~57.0.25",
		"expo-splash-screen": "~57.0.9",
		"react": "19.2.3",
		"react-native": "0.86.3",
		"react-native-reanimated": "4.5.1",
		"react-native-safe-area-context": "~5.7.0",
		"react-native-screens": "~4.26.0",
		"react-native-svg": "15.15.4",
		"react-native-worklets": "0.10.1"
	},
	"devDependencies": {
		"@babel/core": "^7.29.0",
		"@react-native-community/eslint-config": "1.1.0",
		"@types/react": "~19.2.4",
		"babel-jest": "^25.1.0",
		"eslint": "7.32.0",
		"jest": "~29.7.0",
		"prettier": "^2.5.1",
		"react-test-renderer": "16.13.1",
		"typescript": "~6.0.3"
	},
	"jest": {
		"preset": "react-native"
	},
	"eslintConfig": {
		"root": true,
		"ignorePatterns": [
			"expo-env.d.ts"
		],
		"extends": "@react-native-community",
		"plugins": [
			"react",
			"react-native"
		],
		"parserOptions": {
			"ecmaVersion": 2018,
			"sourceType": "module",
			"ecmaFeatures": {
				"jsx": true
			}
		},
		"rules": {
			"semi": "off",
			"comma-dangle": "off",
			"react-native/no-inline-styles": "off",
			"react-native/no-unused-styles": 1,
			"react/jsx-uses-react": "off",
			"react/react-in-jsx-scope": "off"
		},
		"settings": {
			"react": {
				"version": "detect"
			}
		},
		"env": {
			"react-native/react-native": true
		}
	},
	"prettier": {
		"semi": false,
		"tabWidth": 2,
		"singleQuote": true,
		"useTabs": true,
		"bracketSameLine": true,
		"proseWrap": "never",
		"trailingComma": "none"
	}
}
