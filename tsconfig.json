{
	"compilerOptions": {
		"target": "esnext",
		"lib": ["esnext", "dom", "dom.iterable"],
		"allowJs": false,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"noEmit": true
	},
	"extends": "expo/tsconfig.base"
}
